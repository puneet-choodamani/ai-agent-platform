type Query {
    health: String!
    tasks: [Task!]!
    task(id: ID!): Task
}

type Mutation {
    createTask(input: CreateTaskInput!): Task!
    chat(input: ChatInput!): ChatResponse!
    technicalAnswer(input: ChatInput!): TechnicalAnswer!

}

type Task {
    id: ID!
    title: String!
    prompt: String!
    status: TaskStatus!
}

input CreateTaskInput {
    title: String!
    prompt: String!
}

enum TaskStatus {
    CREATED
    IN_PROGRESS
    COMPLETED
    FAILED
}

input ChatInput {
    message: String!
}

type ChatResponse {
    message: String!
}

type TechnicalAnswer {
    answer: String!
    keyPoints: [String!]!
    assumptions: [String!]!
    needsClarification: Boolean!
}